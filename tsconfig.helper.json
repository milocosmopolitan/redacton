{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "rootDir": "helper/src",
    "outDir": "helper/dist",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["helper/src/**/*.ts"]
}
