{
  "name": "redacton",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Local Claude Code credential protection targeting macOS, Linux and Windows; qualification is platform-specific",
  "scripts": {
    "build": "node scripts/build-helper.mjs && node scripts/build-artifact.mjs",
    "build:helper": "node scripts/build-helper.mjs",
    "test": "npm run build:helper && node --experimental-strip-types --test tests/*.test.mjs tests/unit/*.test.ts",
    "test:helper": "npm run build:helper && node --test tests/helper*.test.mjs",
    "test:mod": "node scripts/test-mod.mjs",
    "validate": "node scripts/test-mod.mjs --validate",
    "decisions:validate": "node scripts/validate-decisions.mjs",
    "typecheck": "npm run sdk:types && tsc -p tsconfig.helper.json && tsc -p tsconfig.check.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run typecheck && npm run lint && npm test",
    "sdk:types": "node scripts/test-mod.mjs --types",
    "benchmark": "npm run build:helper && node --experimental-strip-types scripts/assess-quality.mjs",
    "typecheck:pure": "npm run build:helper && tsc -p tsconfig.pure.json",
    "check:pure": "npm run typecheck:pure && npm run lint && npm test",
    "ci:identity": "node scripts/ci-identity.mjs",
    "ci:host": "node scripts/qualify-host.mjs",
    "release:gate": "node scripts/qualification-gate.mjs",
    "test:installer": "node --test tests/installer.test.mjs"
  },
  "engines": {
    "node": ">=22.16.0 <23 || >=24.21.0 <25"
  },
  "dependencies": {
    "@redact-secret/core": "0.1.0-beta.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
